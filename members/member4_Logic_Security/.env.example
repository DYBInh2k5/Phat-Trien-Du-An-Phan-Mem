NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# pretty (kiểu NestJS, dễ đọc) | json (cho máy đọc). Bỏ trống: production => json, còn lại => pretty
LOG_FORMAT=pretty

# Postgres trong docker-compose.yml đọc 4 biến này (docker compose tự nạp .env).
# DATABASE_URL bên dưới PHẢI khớp: postgres://DB_USER:DB_PASSWORD@localhost:DB_PORT/DB_NAME
# Lưu ý: user/password/db chỉ áp dụng khi tạo volume LẦN ĐẦU. Đổi rồi thì: docker compose down -v && docker compose up -d
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=htqllh
DB_PORT=5434
DATABASE_URL=postgres://postgres:postgres@localhost:5434/htqllh

# >= 32 ký tự, KHÁC NHAU, đổi ở môi trường thật (tạo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=10

# Chỉ bật khi demo/báo cáo. Production PHẢI là false.
DEMO_MODE=false
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# Quy chế xếp loại (hiện có: LEGACY_5_LEVELS = Xuất sắc/Giỏi/Khá/Trung bình/Yếu)
GRADING_POLICY=LEGACY_5_LEVELS

# Học kỳ "hiện hành": chỉ học kỳ này mới ghi GPA/học lực vào bảng students
CURRENT_SEMESTER=HK1
CURRENT_SCHOOL_YEAR=2025-2026

# Chỉ dùng cho: npm run seed:admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@12345
ADMIN_FULL_NAME=Quản trị viên
